# Required environment variables — copy to .env.local and fill in values

# Supabase — API REST (usada por el backend, @/lib/supabase/admin.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini
GEMINI_API_KEY=

# Solo para `npm run db:migrate` (scripts/apply-migrations.mjs).
# Ojo: la conexion DIRECTA (db.<ref>.supabase.co) es IPv6-only y falla en
# redes sin IPv6. Usar el POOLER. Sacar el valor de:
#   Dashboard > Project Settings > Database > Connection string > URI
#
# Formato con pooler (puerto 5432 = session mode, 6543 = transaction mode):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
